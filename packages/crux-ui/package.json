{
  "name": "crux-ui",
  "version": "0.0.1",
  "description": "Crux UI — headless, unstyled, accessible UI primitives for Alpine.js.",
  "type": "module",
  "main": "dist/index.js",
  "unpkg": "dist/cdn.min.js",
  "jsdelivr": "dist/cdn.min.js",
  "exports": {
    ".": "./dist/index.js",
    "./collapsible": "./dist/collapsible.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "prepublishOnly": "node scripts/build.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "alpinejs",
    "alpine",
    "headless",
    "unstyled",
    "primitives",
    "accessibility",
    "aria",
    "ui",
    "components",
    "dialog",
    "combobox",
    "tabs",
    "popover"
  ],
  "author": {
    "name": "Jason Baciulis",
    "url": "https://x.com/jasonbaciulis"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jasonbaciulis/crux-ui.git",
    "directory": "packages/crux-ui"
  },
  "homepage": "https://crux-ui.com",
  "peerDependencies": {
    "alpinejs": "^3.12.0"
  },
  "devDependencies": {
    "@alpinejs/collapse": "^3.15.12",
    "alpinejs": "^3.14.0",
    "esbuild": "^0.25.0",
    "jsdom": "^25.0.0",
    "vitest": "^3.0.0"
  }
}
