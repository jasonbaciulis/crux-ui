{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "crux",
  "homepage": "https://crux-ui.com",
  "items": [
    {
      "name": "utils",
      "type": "registry:item",
      "title": "Utils",
      "description": "The cn helper that merges Tailwind classes.",
      "dependencies": ["clsx", "tailwind-merge"],
      "files": [
        {
          "path": "lib/utils.ts",
          "type": "registry:file",
          "target": "src/lib/utils.ts"
        }
      ]
    },
    {
      "name": "button",
      "type": "registry:item",
      "title": "Button",
      "description": "A button with variants and sizes.",
      "meta": { "upstream": "button" },
      "dependencies": ["class-variance-authority"],
      "registryDependencies": ["@crux/utils"],
      "files": [
        {
          "path": "components/ui/button/Button.astro",
          "type": "registry:file",
          "target": "src/components/ui/button/Button.astro"
        },
        {
          "path": "components/ui/button/index.ts",
          "type": "registry:file",
          "target": "src/components/ui/button/index.ts"
        }
      ]
    },
    {
      "name": "collapsible",
      "type": "registry:item",
      "title": "Collapsible",
      "description": "An interactive component which expands/collapses a panel.",
      "dependencies": ["crux-ui"],
      "docs": "Behavior comes from the Crux UI Alpine plugin. Register it once: import Alpine from 'alpinejs'; import CruxUI from 'crux-ui'; Alpine.plugin(CruxUI); Alpine.start()",
      "files": [
        {
          "path": "components/ui/collapsible/Collapsible.astro",
          "type": "registry:file",
          "target": "src/components/ui/collapsible/Collapsible.astro"
        },
        {
          "path": "components/ui/collapsible/CollapsibleTrigger.astro",
          "type": "registry:file",
          "target": "src/components/ui/collapsible/CollapsibleTrigger.astro"
        },
        {
          "path": "components/ui/collapsible/CollapsiblePanel.astro",
          "type": "registry:file",
          "target": "src/components/ui/collapsible/CollapsiblePanel.astro"
        },
        {
          "path": "components/ui/collapsible/index.ts",
          "type": "registry:file",
          "target": "src/components/ui/collapsible/index.ts"
        }
      ]
    },
    {
      "name": "card",
      "type": "registry:item",
      "title": "Card",
      "description": "A card with header, content, footer, and action parts.",
      "meta": { "upstream": "card" },
      "registryDependencies": ["@crux/utils"],
      "files": [
        {
          "path": "components/ui/card/Card.astro",
          "type": "registry:file",
          "target": "src/components/ui/card/Card.astro"
        },
        {
          "path": "components/ui/card/CardHeader.astro",
          "type": "registry:file",
          "target": "src/components/ui/card/CardHeader.astro"
        },
        {
          "path": "components/ui/card/CardTitle.astro",
          "type": "registry:file",
          "target": "src/components/ui/card/CardTitle.astro"
        },
        {
          "path": "components/ui/card/CardDescription.astro",
          "type": "registry:file",
          "target": "src/components/ui/card/CardDescription.astro"
        },
        {
          "path": "components/ui/card/CardAction.astro",
          "type": "registry:file",
          "target": "src/components/ui/card/CardAction.astro"
        },
        {
          "path": "components/ui/card/CardContent.astro",
          "type": "registry:file",
          "target": "src/components/ui/card/CardContent.astro"
        },
        {
          "path": "components/ui/card/CardFooter.astro",
          "type": "registry:file",
          "target": "src/components/ui/card/CardFooter.astro"
        },
        {
          "path": "components/ui/card/index.ts",
          "type": "registry:file",
          "target": "src/components/ui/card/index.ts"
        }
      ]
    }
  ]
}
