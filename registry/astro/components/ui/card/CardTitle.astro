---
import { cn } from "@/lib/utils"

interface Props {
  class?: string
  [attribute: string]: unknown
}

const { class: className, ...rest } = Astro.props
---

<div
  data-slot="card-title"
  class={cn(
    "cn-font-heading text-base leading-snug font-medium group-data-[size=sm]/card:text-sm",
    className
  )}
  {...rest}
>
  <slot />
</div>
