---
import { cn } from "@/lib/utils"

interface Props {
  class?: string
  [attribute: string]: unknown
}

const { class: className, ...rest } = Astro.props
---

<div
  data-slot="card-footer"
  class={cn("flex items-center rounded-b-xl border-t bg-muted/50 p-(--card-spacing)", className)}
  {...rest}
>
  <slot />
</div>
