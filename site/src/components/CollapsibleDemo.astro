<div class="demo not-content">
  <div x-collapsible>
    <button x-collapsible:trigger class="demo-trigger">
      Advanced options
      <svg
        class="demo-icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </button>
    <div x-collapsible:panel x-collapse hidden class="demo-panel">
      <p>
        This panel is a live Crux UI collapsible. The trigger carries real
        <code>aria-expanded</code> and <code>aria-controls</code> attributes, and the chevron is
        styled with a plain CSS <code>[data-panel-open]</code> selector.
      </p>
    </div>
  </div>
</div>

<style>
  .demo {
    border: 1px solid var(--sl-color-gray-5);
