<div x-data x-collapsible class="w-full max-w-sm">
  <button
    x-collapsible:trigger
    class="group/trigger flex cursor-pointer items-center gap-2 py-1 font-semibold text-foreground"
  >
    Advanced options
    <svg
      class="size-4 transition-transform group-data-panel-open/trigger:rotate-180"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      aria-hidden="true"
    >
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </button>
  <div x-collapsible:panel x-collapse hidden class="text-muted-foreground">
    <p class="pt-2">
      This panel is a live Crux UI collapsible. The trigger carries real
      <code>aria-expanded</code> and <code>aria-controls</code> attributes, and the chevron is
      styled with a plain <code>data-panel-open</code> Tailwind variant.
    </p>
  </div>
</div>
