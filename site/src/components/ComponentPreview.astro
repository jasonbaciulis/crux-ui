---
import { Code } from '@astrojs/starlight/components'

const { code, lang = 'html', align = 'center' } = Astro.props

const fullCode = code.trim()
const sourcePreviewCode = fullCode.split('\n').slice(0, 3).join('\n')
---

<div
  data-slot="component-preview"
  class="not-content group relative mt-4 mb-12 flex flex-col overflow-hidden rounded-2xl border border-border"
>
  <div data-slot="preview">
    <div
      data-align={align}
      class="preview relative flex h-72 w-full justify-center p-10 data-[align=center]:items-center data-[align=end]:items-start data-[align=start]:items-start sm:data-[align=end]:items-end"
    >
      <slot />
    </div>
  </div>

  {/* data-closed is authored so the closed-state styles hold before Alpine boots */}
  <div
    data-slot="code"
    x-data
    x-collapsible
    data-closed
    class="group/code relative overflow-hidden border-t border-border [&_pre]:max-h-72"
  >
    <div x-collapsible:panel hidden>
      <Code code={fullCode} lang={lang} />
    </div>
    <div class="relative group-data-open/code:hidden [&_.copy]:hidden" aria-hidden="true">
      <Code code={sourcePreviewCode} lang={lang} />
      <div class="absolute inset-0 bg-linear-to-t from-code via-code/60 to-transparent"></div>
    </div>
    <div
      class="absolute inset-0 flex items-center justify-center pb-4 group-data-open/code:hidden"
    >
      <button x-collapsible:trigger class="sl-link-button secondary relative z-10">
        View Code
      </button>
    </div>
  </div>
</div>
