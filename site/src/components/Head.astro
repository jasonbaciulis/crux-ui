---
import Default from '@astrojs/starlight/components/Head.astro'
---

<Default><slot /></Default>

<script>
  import Alpine from 'alpinejs'
  import collapse from '@alpinejs/collapse'
  import CruxUI from 'crux-ui'

  // Boot Alpine directly instead of via @astrojs/alpinejs: its
  // DOMContentLoaded listener registers too late under Vite's dev-mode
  // module loading, so Alpine.start() never runs in `astro dev`. A module
  // script always executes after the DOM is parsed, so starting here is
  // safe in both dev and build.
  Alpine.plugin(collapse)
  Alpine.plugin(CruxUI)
  window.Alpine = Alpine
  Alpine.start()
</script>
